\begin_inset Formula \[
m=\{\text{transport energy},\ \text{heating},\ \text{processing energy},\ \text{other intermediates}\}
\]
\end_inset

so that 
\begin_inset Formula \[
D_{p,i}=\sum_m\mu_{p,m,i}M_{m,i}
\]
